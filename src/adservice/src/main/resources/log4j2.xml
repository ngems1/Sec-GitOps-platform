<Configuration status="WARN">
  <Appenders>
    <Console name="STDOUT" target="SYSTEM_OUT">

      <!-- One JSON object per line, the fields of the former JsonLayout (instant, thread, level,
           loggerName, message, thrown, endOfBatch, loggerFqcn, threadId, threadPriority, time)
           plus trace_id, span_id and trace_flags (ADR 0011): src/main/resources/boutique-log.json.
           The OpenTelemetry Java agent puts the active span's IDs in the Log4j context data only
           when tracing is on (docker-entrypoint.sh); otherwise, or outside a span, the three
           fields are absent. The former Stackdriver keys (logging.googleapis.com/trace, ...)
           printed the literal text "${ctx:traceId}": they are gone. -->
      <JsonTemplateLayout eventTemplateUri="classpath:boutique-log.json"/>

    </Console>
  </Appenders>
  <Loggers>
    <Logger name="io.grpc.netty" level="INFO"/>
    <Logger name="io.netty" level="INFO"/>
    <Logger name="sun.net" level="INFO"/>
    <Root level="TRACE">
      <AppenderRef ref="STDOUT"/>
    </Root>
  </Loggers>
</Configuration>
